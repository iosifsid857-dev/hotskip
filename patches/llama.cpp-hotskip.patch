+ggml_tensor * llm_graph_context::build_moe_split_experts(ggml_tensor * cur, ggml_tensor * selected_experts, ggml_tensor * weights, int il) const {
+    const llm_moe_split & sp = *moe_split;
+    const int64_t n_embd   = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+    const int64_t n_used   = selected_experts->ne[0];
+
+    ggml_tensor * x = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+
+    // expert id -> slot in a stack: map[selected] via get_rows on a [1, n_expert] view of the map
+    auto remap = [&](ggml_tensor * map) {
+        ggml_tensor * m    = ggml_reshape_2d(ctx0, map, 1, map->ne[0]);
+        ggml_tensor * flat = ggml_reshape_1d(ctx0, ggml_cont(ctx0, selected_experts), n_used * n_tokens);
+        ggml_tensor * ids  = ggml_get_rows(ctx0, m, flat); // [1, n_used*n_tokens]
+        return ggml_reshape_2d(ctx0, ids, n_used, n_tokens);
+    };
+
+    // one SwiGLU expert stack; experts of the other stack hit the zero expert and contribute 0
+    auto run = [&](ggml_tensor * gate, ggml_tensor * up, ggml_tensor * down,
+                   ggml_tensor * gate_b, ggml_tensor * up_b, ggml_tensor * down_b, ggml_tensor * ids, const char * tag) {
+        ggml_tensor * u = ggml_mul_mat_id(ctx0, up,   x, ids); // [n_ff, n_used, n_tokens]
+        ggml_tensor * g = ggml_mul_mat_id(ctx0, gate, x, ids);
+        if (up_b)   { u = ggml_add_id(ctx0, u, up_b,   ids); }
+        if (gate_b) { g = ggml_add_id(ctx0, g, gate_b, ids); }
+        // both activations map (0, 0) -> 0, so the zero expert stays zero
+        // same activation as build_moe_ffn: gpt-oss SwiGLU, clamped SwiGLU (DeepSeek-V4 & co.) or plain SwiGLU;
+        // all of them map (0, 0) -> 0, so the zero expert stays zero
+        const float limit = il >= 0 ? hparams.swiglu_clamp_exp[il] : 0.0f;
+        ggml_tensor * a = nullptr;
+        if (sp.swiglu_oai) {
+            a = ggml_swiglu_oai(ctx0, g, u, 1.702f, 7.0f);
+        } else if (limit > 1e-6f) {
+            if (arch == LLM_ARCH_MAPLE || arch == LLM_ARCH_DEEPSEEK4 || arch == LLM_ARCH_GLM5_NEXT ||
+                (arch == LLM_ARCH_DFLASH && hparams.dsv4_hc_mult > 0) || arch == LLM_ARCH_HY_V4) {
+                a = ggml_swiglu_clamp(ctx0, g, u, limit);
+            } else {
+                a = ggml_mul(ctx0, ggml_clamp(ctx0, ggml_silu(ctx0, g), -INFINITY, limit), ggml_clamp(ctx0, u, -limit, limit));
+            }
+        } else {
+            a = ggml_swiglu_split(ctx0, g, u);
+        }
+        ggml_tensor * d = ggml_mul_mat_id(ctx0, down, a, ids); // [n_embd, n_used, n_tokens]
+        if (down_b) { d = ggml_add_id(ctx0, d, down_b, ids); }
+        cb(d, tag, il);
+        return d;
+    };
+
+    // batched CUDA mul_mat_id (more than 8 tokens) must not see an expert twice in a token: in store mode the
+    // hot ids come without repeats plus a mask; small batches use the shared zero expert as before
+    ggml_tensor * hot_mask = nullptr;
+    ggml_tensor * ids_h = llama_expstore_enabled() && n_tokens > 8
+        ? llama_expstore_hot_ids(ctx0, ggml_cont(ctx0, selected_experts), sp.map_h, &hot_mask)
+        : remap(sp.map_h);
+    ggml_tensor * ids_c = nullptr;
+    const int n_groups = llama_expstore_enabled() ? llama_expstore_groups(il, n_tokens, n_used) : 0;
+    if (n_groups > 0) {
+        // big batch: grouped path below
+    } else if (llama_expstore_enabled()) { // cold experts are paged in from SSD into RAM slots
+        ggml_tensor * slots[6];
+        int n_slots = 0;
+        for (ggml_tensor * t : { sp.gate_c, sp.up_c, sp.down_c, sp.gate_c_b, sp.up_c_b, sp.down_c_b }) {
+            if (t) { slots[n_slots++] = t; }
+        }
+        ids_c = llama_expstore_remap(ctx0, ggml_cont(ctx0, selected_experts), ggml_cont(ctx0, weights), slots, n_slots, il);
+    } else {
+        ids_c = remap(sp.map_c);
+    }
+    cb(ids_h, "ffn_moe_ids_hot", il);
+    if (ids_c) {
+        cb(ids_c, "ffn_moe_ids_cold", il);
+    }
+
+    ggml_tensor * hot  = run(sp.gate_h, sp.up_h, sp.down_h, sp.gate_h_b, sp.up_h_b, sp.down_h_b, ids_h, "ffn_moe_down_hot");
+    if (hot_mask) {
+        hot = ggml_mul(ctx0, hot, hot_mask);
+    }
+    ggml_tensor * cold = nullptr;
+    if (n_groups > 0) { // prompt processing: cold experts in groups that fit RAM, each read once per batch
+        ggml_tensor * slots[6];
+        int n_slots = 0;
+        for (ggml_tensor * t : { sp.gate_c, sp.up_c, sp.down_c, sp.gate_c_b, sp.up_c_b, sp.down_c_b }) {
+            if (t) { slots[n_slots++] = t; }
+        }
+        ggml_tensor * sel = ggml_cont(ctx0, selected_experts);
+        // each group refills the same slot tensors: give every group its own view, so that when big batches are
+        // offloaded to the GPU (op offload) the scheduler copies the slots again instead of reusing group 0's copy
+        auto fresh = [&](ggml_tensor * t) -> ggml_tensor * {
+            if (!t) {
+                return nullptr;
+            }
+            return ggml_view_4d(ctx0, t, t->ne[0], t->ne[1], t->ne[2], t->ne[3], t->nb[1], t->nb[2], t->nb[3], 0);
+        };
+        for (int g = 0; g < n_groups; g++) {
+            ggml_tensor * ids = llama_expstore_remap_group(ctx0, sel, cold, slots, n_slots, il, g);
+            ggml_tensor * c   = run(fresh(sp.gate_c), fresh(sp.up_c), fresh(sp.down_c),
+                                    fresh(sp.gate_c_b), fresh(sp.up_c_b), fresh(sp.down_c_b), ids, "ffn_moe_down_cold");
+            cold = cold ? ggml_add(ctx0, cold, c) : c;
+        }
+    } else {
+        cold = run(sp.gate_c, sp.up_c, sp.down_c, sp.gate_c_b, sp.up_c_b, sp.down_c_b, ids_c, "ffn_moe_down_cold");
+    }
+
+    ggml_tensor * experts = ggml_add(ctx0, hot, cold);
+    cb(experts, "ffn_moe_down", il);
+    return experts;
+}
