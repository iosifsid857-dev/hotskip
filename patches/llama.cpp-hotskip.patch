--- /dev/null
+++ b/src/llama-expstore.cpp
@@ -0,0 +1,610 @@
+#include "llama-expstore.h"
+
+#include "ggml.h"
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <algorithm>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct part_info {
+    std::string name;
+    uint64_t    off;   // file offset of cold-stack index 0
+    uint64_t    bytes; // bytes per expert
+};
+
+struct layer_store {
+    std::vector<part_info> parts;
+    std::vector<int32_t>   cmap;    // expert -> index in the split file's cold stack, -1 if hot
+    std::vector<int32_t>   rank;    // cold experts, most used first
+    std::vector<int32_t>   slot_of; // expert -> slot, -1 if not resident
+    std::vector<int32_t>   owner;   // slot -> expert, -1 if empty
+    std::vector<uint64_t>  last;    // slot -> last use tick
+    std::vector<uint64_t>  stamp;   // slot -> call that used it (never evict within one call)
+    bool                   ready = false;
+    std::vector<uint64_t>  pred_seq_of;  // expert -> prediction round that guessed it
+    std::vector<uint64_t>  pred_load_of; // expert -> round in which it was guessed while not resident
+    uint64_t               pred_seq = 0; // latest prediction round for this layer
+    std::vector<std::vector<int32_t>> chunks; // big batches: distinct cold experts split into groups that fit
+    std::vector<uint64_t>  in_chunk;           // expert -> call id of the group it belongs to
+    std::unique_ptr<std::atomic<uint8_t>[]> busy; // slot is being filled by a background read
+    std::atomic<int>       inflight{0};
+};
+
+struct expstore {
+    int fd = -1;
+    int n_layer = 0, n_expert = 0, slots = 0, pinned = 0;
+    std::deque<layer_store> layers; // deque: layer_store holds atomics and is not movable
+    uint64_t tick = 0, call = 0;
+    uint64_t n_hot = 0, n_hit = 0, n_miss = 0, n_bytes = 0;
+    uint64_t n_miss_pred = 0;              // misses that the previous layer predicted
+    uint64_t n_skip = 0;                   // weak misses skipped (EXPSTORE_SKIP)
+    float    skip_w = 0;
+    uint64_t n_pred_load = 0, n_pred_used = 0; // predicted & not resident; of those, actually used
+    double   io_s = 0;
+    size_t   buf_size = 0;
+    std::vector<void *> bufs;                // one aligned bounce buffer per thread
+    struct load { int il, e, slot; };
+    std::vector<load> pending;               // planned by expstore_plan, executed by expstore_load
+    std::atomic<uint64_t> n_bytes_atomic{0};
+    // background prefetch (EXPSTORE_PREFETCH=1): guessed experts are read while the GPU works
+    struct job { int il, e, slot, p; ggml_tensor * dst[6]; };
+    std::deque<job>         jobs;
+    std::mutex              mu;
+    std::condition_variable cv;
+    std::vector<std::thread> io;
+    bool                    prefetch = false;
+    uint64_t                n_prefetch = 0;
+    std::string stats_path;
+};
+
+expstore * g_store = nullptr;
+bool       g_checked = false;
+
+constexpr uint64_t ALIGN = 4096;
+
+void io_worker(expstore * s, int id);
+
+expstore * load_store(const char * index) {
+    std::ifstream in(index);
+    if (!in) {
+        throw std::runtime_error(std::string("expstore: cannot open index ") + index);
+    }
+    auto * s = new expstore();
+    std::string line, tag, src;
+    int version = 0;
+    std::getline(in, line);
+    std::istringstream(line) >> tag >> version >> src >> s->n_layer >> s->n_expert >> s->slots;
+    if (tag != "expstore" || version != 1) {
+        throw std::runtime_error("expstore: bad index header");
+    }
+    for (int i = 0; i < s->n_layer; i++) {
+        s->layers.emplace_back();
+    }
+    layer_store * cur = nullptr;
+    while (std::getline(in, line)) {
+        std::istringstream ls(line);
+        ls >> tag;
+        if (tag == "layer") {
+            int il = 0;
+            ls >> il;
+            cur = &s->layers.at(il);
+        } else if (tag == "part") {
+            part_info p;
+            ls >> p.name >> p.off >> p.bytes;
+            cur->parts.push_back(p);
+            s->buf_size = std::max<size_t>(s->buf_size, p.bytes + 2 * ALIGN);
+        } else if (tag == "cmap" || tag == "rank") {
+            auto & v = tag == "cmap" ? cur->cmap : cur->rank;
+            for (int32_t x; ls >> x;) {
+                v.push_back(x);
+            }
+        }
+    }
+    const char * pin = getenv("EXPSTORE_PINNED");
+    s->pinned = pin ? atoi(pin) : s->slots / 2;
+    if (const char * sp = getenv("EXPSTORE_STATS")) {
+        s->stats_path = sp;
+    }
+    s->fd = open(src.c_str(), O_RDONLY | O_DIRECT);
+    if (s->fd < 0) {
+        throw std::runtime_error("expstore: cannot open " + src);
+    }
+    s->bufs.assign(GGML_DEFAULT_N_THREADS * 8, nullptr);
+    for (auto & L : s->layers) {
+        L.slot_of.assign(s->n_expert, -1);
+        L.owner.assign(s->slots, -1);
+        L.last.assign(s->slots, 0);
+        L.stamp.assign(s->slots, 0);
+        L.pred_seq_of.assign(s->n_expert, 0);
+        L.pred_load_of.assign(s->n_expert, 0);
+        L.in_chunk.assign(s->n_expert, 0);
+        L.busy.reset(new std::atomic<uint8_t>[s->slots]);
+        for (int i = 0; i < s->slots; i++) {
+            L.busy[i] = 0;
+        }
+    }
+    if (const char * sk = getenv("EXPSTORE_SKIP")) {
+        s->skip_w = (float) atof(sk);
+    }
+    if (const char * pf = getenv("EXPSTORE_PREFETCH")) {
+        const int n_io = atoi(pf);
+        s->prefetch = n_io > 0;
+        for (int i = 0; i < n_io; i++) {
+            s->io.emplace_back(io_worker, s, i);
+            s->io.back().detach();
+        }
+    }
+    fprintf(stderr, "expstore: %s, %d layers, %d slots/layer (%d pinned)\n", src.c_str(), s->n_layer, s->slots, s->pinned);
+    return s;
+}
+
+void read_part(expstore & s, const layer_store & L, int e, int slot, size_t p, ggml_tensor * dst_p, void * buf);
+
+void io_worker(expstore * s, int id) {
+    void * buf = nullptr;
+    if (posix_memalign(&buf, ALIGN, s->buf_size) != 0) {
+        GGML_ABORT("expstore: out of memory");
+    }
+    (void) id;
+    for (;;) {
+        expstore::job j;
+        {
+            std::unique_lock<std::mutex> lk(s->mu);
+            s->cv.wait(lk, [&] { return !s->jobs.empty(); });
+            j = s->jobs.front();
+            s->jobs.pop_front();
+        }
+        layer_store & L = s->layers[j.il];
+        read_part(*s, L, j.e, j.slot, j.p, j.dst[j.p], buf);
+        L.busy[j.slot]--; // counts the parts still in flight
+        L.inflight--;
+    }
+}
+
+void write_stats(const expstore & s) {
+    if (s.stats_path.empty()) {
+        return;
+    }
+    FILE * f = fopen(s.stats_path.c_str(), "w");
+    if (f) {
+        fprintf(f, "{\"calls\": %llu, \"hot\": %llu, \"hit\": %llu, \"miss\": %llu, \"read_mb\": %.1f, "
+                   "\"miss_predicted\": %llu, \"pred_load\": %llu, \"pred_used\": %llu, \"prefetched\": %llu, \"skipped\": %llu}\n",
+                (unsigned long long) s.call, (unsigned long long) s.n_hot, (unsigned long long) s.n_hit,
+                (unsigned long long) s.n_miss, s.n_bytes / 1e6, (unsigned long long) s.n_miss_pred,
+                (unsigned long long) s.n_pred_load, (unsigned long long) s.n_pred_used,
+                (unsigned long long) s.n_prefetch, (unsigned long long) s.n_skip);
+        fclose(f);
+    }
+}
+
+// copy cold expert `e` of layer `il` from the file into slot `slot` of every part
+// one part (gate / up / down / a bias) of cold expert e into its slot; parts are read independently so
+// the reads of a layer's misses can all be in flight at once (NVMe needs queue depth >= 4 for full speed)
+void read_part(expstore & s, const layer_store & L, int e, int slot, size_t p, ggml_tensor * dst_p, void * buf) {
+    const int64_t j = L.cmap[e];
+    {
+        const part_info & pi = L.parts[p];
+        // experts are the outermost dimension: ne[2] for [in, out, n] weights, ne[1] for [out, n] biases
+        GGML_ASSERT((uint64_t) (dst_p->ne[2] > 1 ? dst_p->nb[2] : dst_p->nb[1]) == pi.bytes);
+        const uint64_t off  = pi.off + j * pi.bytes;
+        const uint64_t beg  = off & ~(ALIGN - 1);
+        const uint64_t end  = (off + pi.bytes + ALIGN - 1) & ~(ALIGN - 1);
+        size_t done = 0;
+        while (done < end - beg) {
+            const ssize_t r = pread(s.fd, (char *) buf + done, end - beg - done, beg + done);
+            if (r <= 0) {
+                GGML_ABORT("expstore: read failed for %s", pi.name.c_str());
+            }
+            done += r;
+        }
+        memcpy((char *) dst_p->data + (size_t) slot * pi.bytes, (char *) buf + (off - beg), pi.bytes);
+        s.n_bytes_atomic += end - beg;
+    }
+}
+
+void * thread_buf(expstore & s, int ith) {
+    GGML_ASSERT(ith < (int) s.bufs.size());
+    if (!s.bufs[ith] && posix_memalign(&s.bufs[ith], ALIGN, s.buf_size) != 0) {
+        GGML_ABORT("expstore: out of memory");
+    }
+    return s.bufs[ith];
+}
+
+void place(expstore & s, layer_store & L, int il, int e, int slot) {
+    if (L.owner[slot] >= 0) {
+        L.slot_of[L.owner[slot]] = -1;
+    }
+    s.pending.push_back({ il, e, slot });
+    L.owner[slot] = e;
+    L.slot_of[e]  = slot;
+}
+
+// pass 1 (one thread): decide slots, queue the misses
+void expstore_plan(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) nth;
+    if (ith != 0) {
+        return;
+    }
+    expstore & s = *g_store;
+    const int il = (int) (intptr_t) userdata;
+    layer_store & L = s.layers[il];
+    const ggml_tensor * sel = dst->src[0];
+    s.pending.clear();
+    while (L.inflight.load() > 0) { // background prefetch of this layer must land before slots are reassigned
+        std::this_thread::yield();
+    }
+
+    if (!L.ready) { // pin the most used cold experts of this layer
+        for (int i = 0; i < s.pinned && i < (int) L.rank.size(); i++) {
+            place(s, L, il, L.rank[i], i);
+        }
+        L.ready = true;
+    }
+
+    s.call++;
+    const int64_t n_used = sel->ne[0], n_tok = sel->ne[1];
+    for (int64_t t = 0; t < n_tok; t++) {
+        for (int64_t k = 0; k < n_used; k++) {
+            const int32_t e = *(const int32_t *) ((const char *) sel->data + t * sel->nb[1] + k * sel->nb[0]);
+            int32_t & out = *(int32_t *) ((char *) dst->data + t * dst->nb[1] + k * dst->nb[0]);
+            if (L.cmap[e] < 0) {
+                out = -1;
+                s.n_hot++;
+                continue;
+            }
+            int slot = L.slot_of[e];
+            const bool predicted = L.pred_seq > 0 && L.pred_seq_of[e] == L.pred_seq;
+            if (predicted && L.pred_load_of[e] == L.pred_seq) {
+                s.n_pred_used++;
+                L.pred_load_of[e] = 0; // count once
+            }
+            if (slot < 0 && s.skip_w > 0) {
+                // weak expert not in RAM: skip it rather than wait for the SSD. "Weak" is relative to the
+                // token's mean routing weight, so one setting fits models with different top-k and scaling.
+                const ggml_tensor * w = dst->src[1];
+                auto wt = [&](int64_t kk) { return *(const float *) ((const char *) w->data + t * w->nb[2] + kk * w->nb[1]); };
+                float mean = 0;
+                for (int64_t kk = 0; kk < n_used; kk++) {
+                    mean += wt(kk) / n_used;
+                }
+                if (wt(k) < s.skip_w * mean) {
+                    out = -1;
+                    s.n_skip++;
+                    continue;
+                }
+            }
+            if (slot >= 0) {
+                s.n_hit++;
+            } else {
+                s.n_miss++;
+                s.n_miss_pred += predicted;
+                int victim = -1;
+                for (int i = s.pinned; i < s.slots; i++) {
+                    if (L.stamp[i] != s.call && !L.busy[i] && (victim < 0 || L.last[i] < L.last[victim])) {
+                        victim = i;
+                    }
+                }
+                if (victim < 0) {
+                    GGML_ABORT("expstore: layer %d needs more than %d LRU slots in one batch, lower -ub", il, s.slots - s.pinned);
+                }
+                place(s, L, il, e, victim);
+                slot = victim;
+            }
+            L.last[slot]  = ++s.tick;
+            L.stamp[slot] = s.call;
+            out = slot;
+        }
+    }
+    if (s.call % 400 == 0) {
+        s.n_bytes = s.n_bytes_atomic;
+        write_stats(s);
+    }
+}
+
+// big batches (prompt processing): group g of G. Group 0 splits the batch's distinct cold experts into
+// chunks that fit the LRU slots - resident ones first - and every group loads and serves one chunk,
+// so each expert is read from SSD at most once per batch. Groups run in order (each depends on the
+// previous group's output), so a chunk is never evicted before its experts were computed.
+void expstore_group_plan(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) nth;
+    if (ith != 0) {
+        return;
+    }
+    expstore & s = *g_store;
+    const int il = (int) ((intptr_t) userdata >> 8), g = (int) ((intptr_t) userdata & 0xff);
+    layer_store & L = s.layers[il];
+    const ggml_tensor * sel = dst->src[0];
+    const int64_t n_used = sel->ne[0], n_tok = sel->ne[1];
+    auto expert_at = [&](int64_t t, int64_t k) {
+        return *(const int32_t *) ((const char *) sel->data + t * sel->nb[1] + k * sel->nb[0]);
+    };
+    s.pending.clear();
+    while (L.inflight.load() > 0) { // background prefetch of this layer must land before slots are reassigned
+        std::this_thread::yield();
+    }
+
+    if (!L.ready) {
+        for (int i = 0; i < s.pinned && i < (int) L.rank.size(); i++) {
+            place(s, L, il, L.rank[i], i);
+        }
+        L.ready = true;
+    }
+    s.call++;
+
+    if (g == 0) {
+        std::vector<int32_t> pinned_res, lru_res, missing;
+        std::vector<uint8_t> seen(s.n_expert, 0);
+        for (int64_t t = 0; t < n_tok; t++) {
+            for (int64_t k = 0; k < n_used; k++) {
+                const int32_t e = expert_at(t, k);
+                if (L.cmap[e] < 0 || seen[e]) {
+                    continue;
+                }
+                seen[e] = 1;
+                const int slot = L.slot_of[e];
+                (slot < 0 ? missing : slot < s.pinned ? pinned_res : lru_res).push_back(e);
+            }
+        }
+        const size_t cap = s.slots - s.pinned;
+        static const size_t cap_dbg = getenv("EXPSTORE_CHUNK") ? atoi(getenv("EXPSTORE_CHUNK")) : 0; // debug
+        const size_t cap2 = cap_dbg ? std::min(cap, cap_dbg) : cap;
+        // pinned experts never move, so they need no capacity and ride along with group 0
+        std::vector<int32_t> rest = lru_res;
+        rest.insert(rest.end(), missing.begin(), missing.end());
+        L.chunks.assign(1, pinned_res);
+        for (size_t i = 0; i < rest.size(); i += cap2) {
+            if (i > 0) {
+                L.chunks.emplace_back();
+            }
+            L.chunks.back().insert(L.chunks.back().end(), rest.begin() + i, rest.begin() + std::min(rest.size(), i + cap2));
+        }
+    }
+
+    if (g < (int) L.chunks.size()) {
+        for (int32_t e : L.chunks[g]) {
+            L.in_chunk[e] = s.call;
+            if (L.slot_of[e] >= 0) {
+                s.n_hit++;
+            } else {
+                s.n_miss++;
+                int victim = -1;
+                for (int i = s.pinned; i < s.slots; i++) {
+                    if (L.stamp[i] != s.call && !L.busy[i] && (victim < 0 || L.last[i] < L.last[victim])) {
+                        victim = i;
+                    }
+                }
+                if (victim < 0) {
+                    GGML_ABORT("expstore: layer %d group %d does not fit %d LRU slots", il, g, s.slots - s.pinned);
+                }
+                place(s, L, il, e, victim);
+            }
+            L.last[L.slot_of[e]]  = ++s.tick;
+            L.stamp[L.slot_of[e]] = s.call;
+        }
+    }
+    for (int64_t t = 0; t < n_tok; t++) {
+        for (int64_t k = 0; k < n_used; k++) {
+            const int32_t e = expert_at(t, k);
+            *(int32_t *) ((char *) dst->data + t * dst->nb[1] + k * dst->nb[0]) =
+                L.cmap[e] >= 0 && L.in_chunk[e] == s.call ? L.slot_of[e] : -1;
+        }
+    }
+}
+
+// pass 2 (all threads): read the queued experts in parallel, pass the slot ids through
+void expstore_load(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    expstore & s = *g_store;
+    const layer_store & L = s.layers[(int) (intptr_t) userdata];
+    ggml_tensor * const * parts = dst->src + 1;
+    (void) L;
+    const size_t n_parts = L.parts.size();
+    for (size_t i = ith; i < s.pending.size() * n_parts; i += nth) {
+        const auto & ld = s.pending[i / n_parts];
+        read_part(s, L, ld.e, ld.slot, i % n_parts, parts[i % n_parts], thread_buf(s, ith));
+    }
+    if (ith == 0) {
+        memcpy(dst->data, dst->src[0]->data, ggml_nbytes(dst));
+        while (s.layers[(int) (intptr_t) userdata].inflight.load() > 0) {
+            std::this_thread::yield();
+        }
+    }
+}
+
+void expstore_predict(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) nth;
+    if (ith != 0) {
+        return;
+    }
+    expstore & s = *g_store;
+    layer_store & L = s.layers[(int) (intptr_t) userdata];
+    const ggml_tensor * topk = dst->src[0];
+    L.pred_seq++;
+    for (int64_t t = 0; t < topk->ne[1]; t++) {
+        for (int64_t k = 0; k < topk->ne[0]; k++) {
+            const int32_t e = *(const int32_t *) ((const char *) topk->data + t * topk->nb[1] + k * topk->nb[0]);
+            if (L.pred_seq_of[e] == L.pred_seq) {
+                continue;
+            }
+            L.pred_seq_of[e] = L.pred_seq;
+            if (L.cmap[e] >= 0 && L.slot_of[e] < 0) {
+                L.pred_load_of[e] = L.pred_seq;
+                s.n_pred_load++;
+                if (s.prefetch && L.ready) {
+                    int victim = -1;
+                    for (int i = s.pinned; i < s.slots; i++) {
+                        if (!L.busy[i] && (victim < 0 || L.last[i] < L.last[victim])) {
+                            victim = i;
+                        }
+                    }
+                    if (victim < 0) {
+                        continue;
+                    }
+                    if (L.owner[victim] >= 0) {
+                        L.slot_of[L.owner[victim]] = -1;
+                    }
+                    L.owner[victim] = e;
+                    L.slot_of[e]    = victim;
+                    L.last[victim]  = ++s.tick;
+                    const int n_parts = (int) L.parts.size();
+                    L.busy[victim]  = (uint8_t) n_parts;
+                    L.inflight     += n_parts;
+                    expstore::job j { (int) (intptr_t) userdata, e, victim, 0, {} };
+                    for (int p = 0; p < n_parts; p++) {
+                        j.dst[p] = dst->src[1 + p];
+                    }
+                    {
+                        std::lock_guard<std::mutex> lk(s.mu);
+                        for (int p = 0; p < n_parts; p++) {
+                            j.p = p;
+                            s.jobs.push_back(j);
+                        }
+                    }
+                    s.cv.notify_all();
+                    s.n_prefetch++;
+                }
+            }
+        }
+    }
+}
+
+} // namespace
+
+bool llama_expstore_enabled() {
+    if (!g_checked) {
+        g_checked = true;
+        if (const char * index = getenv("EXPSTORE_INDEX")) {
+            g_store = load_store(index);
+            atexit([] { g_store->n_bytes = g_store->n_bytes_atomic; write_stats(*g_store); });
+        }
+    }
+    return g_store != nullptr;
+}
+
+ggml_tensor * llama_expstore_remap(ggml_context * ctx, ggml_tensor * selected, ggml_tensor * weights, ggml_tensor ** slots, int n_slots, int il) {
+    GGML_ASSERT(selected->type == GGML_TYPE_I32);
+    void * ud = (void *) (intptr_t) il;
+    ggml_tensor * pargs[2] = { selected, weights };
+    ggml_tensor * plan = ggml_custom_4d(ctx, GGML_TYPE_I32, selected->ne[0], selected->ne[1], 1, 1,
+                                        pargs, 2, expstore_plan, 1, ud);
+    std::vector<ggml_tensor *> args = { plan };
+    args.insert(args.end(), slots, slots + n_slots);
+    return ggml_custom_4d(ctx, GGML_TYPE_I32, selected->ne[0], selected->ne[1], 1, 1,
+                          args.data(), (int) args.size(), expstore_load, GGML_N_TASKS_MAX, ud);
+}
+
+ggml_tensor * llama_expstore_predict(ggml_context * ctx, ggml_tensor * topk, ggml_tensor ** slots, int n_slots, int il) {
+    std::vector<ggml_tensor *> args = { topk };
+    args.insert(args.end(), slots, slots + n_slots);
+    return ggml_custom_4d(ctx, GGML_TYPE_I32, 1, 1, 1, 1, args.data(), (int) args.size(), expstore_predict, 1,
+                          (void *) (intptr_t) il);
+}
+
+int llama_expstore_groups(int il, int64_t n_tokens, int64_t n_used) {
+    const expstore & s = *g_store;
+    int64_t cap = s.slots - s.pinned;
+    if (n_tokens * n_used <= cap) {
+        return 0; // fits the LRU slots in one go: the decode path
+    }
+    int64_t n_cold = 0;
+    for (int32_t c : s.layers[il].cmap) {
+        n_cold += c >= 0;
+    }
+    if (const char * c = getenv("EXPSTORE_CHUNK")) {
+        cap = std::min<int64_t>(cap, atoi(c));
+    }
+    return (int) std::min<int64_t>(255, (n_cold + cap - 1) / cap + 1);
+}
+
+ggml_tensor * llama_expstore_remap_group(ggml_context * ctx, ggml_tensor * selected, ggml_tensor * dep,
+                                         ggml_tensor ** slots, int n_slots, int il, int g) {
+    ggml_tensor * pargs[2] = { selected, dep };
+    ggml_tensor * plan = ggml_custom_4d(ctx, GGML_TYPE_I32, selected->ne[0], selected->ne[1], 1, 1, pargs, dep ? 2 : 1,
+                                        expstore_group_plan, 1, (void *) (intptr_t) ((il << 8) | g));
+    std::vector<ggml_tensor *> args = { plan };
+    args.insert(args.end(), slots, slots + n_slots);
+    return ggml_custom_4d(ctx, GGML_TYPE_I32, selected->ne[0], selected->ne[1], 1, 1,
+                          args.data(), (int) args.size(), expstore_load, GGML_N_TASKS_MAX, (void *) (intptr_t) il);
+}
+
+namespace {
+
+// hot stack ids without repeats inside a token: positions routed to cold experts get distinct hot slots that
+// the token does not use (their output is masked to 0), because CUDA's batched mul_mat_id breaks when one
+// expert appears twice in a token - which the shared zero expert of the hot stack would cause.
+void expstore_hot_ids(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) nth; (void) userdata;
+    if (ith != 0) {
+        return;
+    }
+    const ggml_tensor * sel = dst->src[0];
+    const int32_t * hmap = (const int32_t *) dst->src[1]->data;
+    const int64_t n_expert = dst->src[1]->ne[0], n_used = sel->ne[0], n_tok = sel->ne[1];
+    int32_t zero = 0;
+    for (int64_t e = 0; e < n_expert; e++) {
+        zero = std::max(zero, hmap[e]);
+    }
+    std::vector<int32_t> slot(n_used);
+    for (int64_t t = 0; t < n_tok; t++) {
+        for (int64_t k = 0; k < n_used; k++) {
+            slot[k] = hmap[*(const int32_t *) ((const char *) sel->data + t * sel->nb[1] + k * sel->nb[0])];
+        }
+        int32_t next = 0;
+        for (int64_t k = 0; k < n_used; k++) {
+            if (slot[k] == zero) {
+                while (std::find(slot.begin(), slot.end(), next) != slot.end()) {
+                    next++;
+                }
+                GGML_ASSERT(next < zero && "expstore: hot stack too small for distinct filler slots");
+                slot[k] = next++;
+            }
+            *(int32_t *) ((char *) dst->data + t * dst->nb[1] + k * dst->nb[0]) = slot[k];
+        }
+    }
+}
+
+void expstore_hot_mask(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) nth; (void) userdata;
+    if (ith != 0) {
+        return;
+    }
+    const ggml_tensor * sel = dst->src[0];
+    const int32_t * hmap = (const int32_t *) dst->src[1]->data;
+    const int64_t n_expert = dst->src[1]->ne[0], n_used = sel->ne[0], n_tok = sel->ne[1];
+    int32_t zero = 0;
+    for (int64_t e = 0; e < n_expert; e++) {
+        zero = std::max(zero, hmap[e]);
+    }
+    for (int64_t t = 0; t < n_tok; t++) {
+        for (int64_t k = 0; k < n_used; k++) {
+            const int32_t e = *(const int32_t *) ((const char *) sel->data + t * sel->nb[1] + k * sel->nb[0]);
+            ((float *) dst->data)[t * n_used + k] = hmap[e] == zero ? 0.0f : 1.0f;
+        }
+    }
+}
+
+} // namespace
+
+ggml_tensor * llama_expstore_hot_ids(ggml_context * ctx, ggml_tensor * selected, ggml_tensor * map_h, ggml_tensor ** mask) {
+    ggml_tensor * args[2] = { selected, map_h };
+    *mask = ggml_custom_4d(ctx, GGML_TYPE_F32, 1, selected->ne[0], selected->ne[1], 1, args, 2, expstore_hot_mask, 1, nullptr);
+    return ggml_custom_4d(ctx, GGML_TYPE_I32, selected->ne[0], selected->ne[1], 1, 1, args, 2, expstore_hot_ids, 1, nullptr);
+}
