--- /dev/null
+++ b/src/llama-expstore.h
@@ -0,0 +1,33 @@
+#pragma once
+
+// Expert store (llm-lab experiment): cold MoE experts live on SSD; a fixed number of RAM slots per
+// layer holds them (part pinned by popularity, the rest LRU). Enabled by EXPSTORE_INDEX=<index file>
+// written by llm-lab/make_store.py; the model must be the matching skeleton GGUF loaded with
+// --load-mode none so the slot tensors are writable.
+
+#include <cstdint>
+
+struct ggml_context;
+struct ggml_tensor;
+
+bool llama_expstore_enabled();
+
+// selected: I32 [n_used, n_tokens], contiguous. slots: the layer's cold slot tensors in index order
+// (gate, up, down weights, then biases). Returns I32 [n_used, n_tokens]: slot per expert, -1 if hot.
+// weights: routing weights [1, n_used, n_tokens]; with EXPSTORE_SKIP=<f>, a cold expert that is not in RAM and
+// has weight < f * (mean weight of the token's experts) is skipped (output 0) instead of being read from SSD.
+ggml_tensor * llama_expstore_remap(ggml_context * ctx, ggml_tensor * selected, ggml_tensor * weights, ggml_tensor ** slots, int n_slots, int il);
+
+// Prediction for the next layer (EXPSTORE_PREDICT=1): topk = I32 [k, n_tokens] experts guessed for layer il.
+// Records them; the plan of layer il then reports how many of its misses were guessed.
+ggml_tensor * llama_expstore_predict(ggml_context * ctx, ggml_tensor * topk, ggml_tensor ** slots, int n_slots, int il);
+
+// Big batches: number of expert groups to build for layer il (0 = use llama_expstore_remap), and group g's
+// slot ids. dep (may be null) is the previous group's output, so groups run strictly in order.
+int llama_expstore_groups(int il, int64_t n_tokens, int64_t n_used);
+ggml_tensor * llama_expstore_remap_group(ggml_context * ctx, ggml_tensor * selected, ggml_tensor * dep,
+                                         ggml_tensor ** slots, int n_slots, int il, int g);
+
+// Big batches, hot (GPU) stack: slot ids with no expert repeated inside a token, plus a [1, n_used, n_tokens]
+// mask that zeroes the positions routed to cold experts. Multiply the hot output by the mask.
+ggml_tensor * llama_expstore_hot_ids(ggml_context * ctx, ggml_tensor * selected, ggml_tensor * map_h, ggml_tensor ** mask);
